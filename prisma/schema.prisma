generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  name              String?
  gender            String?
  age               Int?
  height            Float?
  weight            Float?
  systolic          Int?
  diastolic         Int?
  initialAge        Int?
  initialHeight     Float?
  initialWeight     Float?
  initialSystolic   Int?
  initialDiastolic  Int?
  hasSavedSettings  Boolean  @default(false)
  chronicConditions String?
  healthGoals       String?
  courseStartDate   DateTime?
  currentDayIndex   Int      @default(1)
  lastActiveDate    DateTime?
  ritualTime        String?  @default("21:00")
  lastAchievementUnlockedAt DateTime?
  pendingAchievementId      String?
  constructorCount          Int      @default(0)
  scanCount                 Int      @default(0)
  chapterReadCount          Int      @default(0)
  shareCount                Int      @default(0)
  feedbackCount             Int      @default(0)
  clickCount                Int      @default(0)

  dailyMetrics        DailyMetric[]
  dailyRatings        DailyRating[]
  recipeProgress      RecipeProgress[]
  savedDishes         SavedDish[]
  diaryEntries        DiaryEntry[]
  shoppingItems       ShoppingItem[]
  purchases           Purchase[]
  annaChats           AnnaChat[]
  annaOverlayMessages AnnaOverlayMessage[]
  userAchievements    UserAchievement[]
  eveningRituals      EveningRitual[]

  telegramId          String?   @unique
  telegramName        String?
  telegramUsername    String?
  clubToken           String?
  clubTokenExpiresAt  DateTime?
  clubLinkedAt        DateTime?
}

model DailyMetric {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  date            DateTime @default(now())
  dayIndex        Int

  waterMl         Int      @default(0)
  sleepMinutes    Int      @default(0)
  mealCount       Int      @default(0)
  habitsDone      Int      @default(0)
  activityMinutes Int      @default(0)
  steps           Int      @default(0)
  waterEntries    String?
  sleepLogs       String?
  digestionLog    String?
  movementLog     String?
  measurements    String?
  dayMood         String?
  dayBookmark     String?

  @@unique([userId, date])
}

model DailyRating {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  date         DateTime @default(now())
  wellbeing    Int
  energy       Int
  lightness    Int
  wellbeingLog String?  // JSON array of {time, val}
  energyLog    String?
  lightnessLog String?

  @@unique([userId, date])
}

model BookRecipe {
  type            String
  id              Int
  technicalName   String
  emotionalName   String?
  week            String?
  page            Int?
  day             Int?
  timeOfDay       String?

  ingredients     String
  instructions    String
  kbju            String

  progress  RecipeProgress[]

  @@id([type, id])
}

model RecipeProgress {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  bookRecipeType  String
  bookRecipeId    Int
  bookRecipe      BookRecipe @relation(fields: [bookRecipeType, bookRecipeId], references: [type, id])
  status          String     @default("base")
  note            String?
  tags            String?
  dayIndex        Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, bookRecipeType, bookRecipeId])
}

model SavedDish {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  image           String?
  category        String
  tag             String?
  createdAt       DateTime @default(now())
  isFavorite      Boolean  @default(false)
  dayIndex        Int?

  isBookRecipe    Boolean  @default(false)
  bookRecipeType  String?
  bookRecipeId    Int?
  sourceType      String?
  ingredients     String?
  calories        Int?
  protein         String?
  fiber           String?
  fat             String?
  annaTip         String?
  annaComment     String?
  isNew           Boolean  @default(true)
}

model DiaryEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dayIndex  Int
  createdAt DateTime @default(now())

  note      String?
  mood      String?
  photo     String?
  tags      String?
  time      String?
}

model ShoppingItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcode       String?
  name          String
  brand         String?
  imageUrl      String?
  verdictStatus String   @default("green")
  checked       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  category  String
  status    String   @default("pending")
  dayIndex  Int?
  createdAt DateTime @default(now())
}

model AnnaChat {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  reply     String?
  screen    String?
  dayIndex  Int?
  createdAt DateTime @default(now())
}

model AnnaOverlayMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  sender    String
  text      String
  time      String?
  dayIndex  Int?
  createdAt DateTime @default(now())
}

model Achievement {
  id               String   @id
  name             String
  category         String
  type             String
  rarity           String
  xp               Int
  descriptionMale  String
  descriptionFemale String
  image            String
  isSecret         Boolean  @default(false)
  availableFromDay Int      @default(1)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlocked      Boolean   @default(false)
  unlockedAt    DateTime?
  xp            Int       @default(0)

  @@unique([userId, achievementId])
}

model EveningRitual {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  dayIndex        Int
  answerBody      String
  answerPsycho    String
  answerUnexpected String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, dayIndex])
}
