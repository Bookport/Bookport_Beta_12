generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                      String?
  gender                    String?
  age                       Int?
  height                    Float?
  weight                    Float?
  systolic                  Int?
  diastolic                 Int?
  initialAge                Int?
  initialHeight             Float?
  initialWeight             Float?
  initialSystolic           Int?
  initialDiastolic          Int?
  hasSavedSettings          Boolean   @default(false)
  chronicConditions         String?
  healthGoals               String?
  courseStartDate           DateTime?
  currentDayIndex           Int       @default(1)
  lastActiveDate            DateTime?
  ritualTime                String?   @default("21:00")
  lastAchievementUnlockedAt DateTime?

  pendingAchievementId String?
  constructorCount     Int     @default(0)
  scanCount            Int     @default(0)
  chapterReadCount     Int     @default(0)
  shareCount           Int     @default(0)
  feedbackCount        Int     @default(0)
  clickCount           Int     @default(0)
  compositionViewLog   String? @default("[]")
  annaDislikeCount     Int     @default(0)
  annaChatCount        Int     @default(0)
  globalProgress       Int     @default(0)

  dailyMetrics        DailyMetric[]
  dailyRatings        DailyRating[]
  recipeProgress      RecipeProgress[]
  savedDishes         SavedDish[]
  diaryEntries        DiaryEntry[]
  shoppingItems       ShoppingItem[]
  purchases           Purchase[]
  annaChats           AnnaChat[]
  annaOverlayMessages AnnaOverlayMessage[]
  userAchievements    UserAchievement[]
  eveningRituals      EveningRitual[]

  telegramId       String?   @unique
  telegramName     String?
  telegramUsername String?
  purchasedAt      DateTime?
  clubLinkedAt     DateTime?
  accessExpiresAt  DateTime?
}

model PurchaseToken {
  id              String    @id @default(uuid())
  token           String    @unique
  email           String?
  used            Boolean   @default(false)
  telegramId      String?
  usedAt          DateTime?
  expiresAt       DateTime
  accessStartsAt  DateTime?
  externalOrderId String?
  createdAt       DateTime  @default(now())
}

model AppLaunchToken {
  id         String   @id @default(uuid())
  token      String   @unique
  telegramId String?
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

model DailyMetric {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  date     DateTime @default(now())
  dayIndex Int

  waterMl         Int     @default(0)
  sleepMinutes    Int     @default(0)
  mealCount       Int     @default(0)
  habitsDone      Int     @default(0)
  activityMinutes Int     @default(0)
  steps           Int     @default(0)
  waterEntries    String?
  sleepLogs       String?
  digestionLog    String?
  movementLog     String?
  measurements    String?
  dayMood         String?
  dayBookmark     String?

  @@unique([userId, date])
}

model DailyRating {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  date         DateTime @default(now())
  wellbeing    Int
  energy       Int
  lightness    Int
  wellbeingLog String? // JSON array of {time, val}
  energyLog    String?
  lightnessLog String?

  @@unique([userId, date])
}

model BookRecipe {
  type          String
  id            Int
  technicalName String
  page          Int?
  day           Int?

  ingredients  String
  instructions String
  kbju         String

  progress RecipeProgress[]

  @@id([type, id])
}

model RecipeProgress {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  bookRecipeType String
  bookRecipeId   Int
  bookRecipe     BookRecipe @relation(fields: [bookRecipeType, bookRecipeId], references: [type, id])
  status         String     @default("base")
  note           String?
  tags           String?
  dayIndex       Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, bookRecipeType, bookRecipeId])
}

model SavedDish {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  name       String
  image      String?
  category   String
  tag        String?
  createdAt  DateTime @default(now())
  isFavorite Boolean  @default(false)
  dayIndex   Int?

  isBookRecipe   Boolean @default(false)
  bookRecipeType String?
  bookRecipeId   Int?
  sourceType     String?
  ingredients    String?
  calories       Int?
  protein        String?
  fiber          String?
  fat            String?
  annaTip        String?
  annaComment    String?
  isNew          Boolean @default(true)

  // Расширенные нутриенты (Float, стандартизированы с FoodItem)
  water             Float  @default(0)
  carbohydrates     Float  @default(0)
  sugarTotal        Float  @default(0)
  sucrose           Float  @default(0)
  glucose           Float  @default(0)
  fructose          Float  @default(0)
  lactose           Float  @default(0)
  maltose           Float  @default(0)
  saturatedFat      Float  @default(0)
  monounsaturatedFat Float @default(0)
  polyunsaturatedFat Float @default(0)
  transFat          Float  @default(0)
  cholesterol       Float  @default(0)
  omega3            Float  @default(0)
  omega6            Float  @default(0)
  omega9            Float  @default(0)
  calcium           Float  @default(0)
  iron              Float  @default(0)
  magnesium         Float  @default(0)
  phosphorus        Float  @default(0)
  potassium         Float  @default(0)
  sodium            Float  @default(0)
  zinc              Float  @default(0)
  copper            Float  @default(0)
  manganese         Float  @default(0)
  iodine            Float  @default(0)
  selenium          Float  @default(0)
  vitaminC          Float  @default(0)
  thiamin           Float  @default(0)
  riboflavin        Float  @default(0)
  niacin            Float  @default(0)
  pantothenicAcid   Float  @default(0)
  vitaminB6         Float  @default(0)
  biotin            Float  @default(0)
  folate            Float  @default(0)
  vitaminB12        Float  @default(0)
  vitaminA          Float  @default(0)
  retinol           Float  @default(0)
  betaCarotene      Float  @default(0)
  vitaminD          Float  @default(0)
  vitaminD2         Float  @default(0)
  vitaminD3         Float  @default(0)
  vitaminE          Float  @default(0)
  vitaminK          Float  @default(0)
  lysine            Float  @default(0)
  methionine        Float  @default(0)
  tryptophan        Float  @default(0)
  threonine         Float  @default(0)
  isoleucine        Float  @default(0)
  leucine           Float  @default(0)
  cystine           Float  @default(0)
  phenylalanine     Float  @default(0)
  tyrosine          Float  @default(0)
  valine            Float  @default(0)
  arginine          Float  @default(0)
  histidine         Float  @default(0)
  alanine           Float  @default(0)
  asparticAcid      Float  @default(0)
  glutamicAcid      Float  @default(0)
  glycine           Float  @default(0)
  proline           Float  @default(0)
  serine            Float  @default(0)
}

model DiaryEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dayIndex  Int
  createdAt DateTime @default(now())

  note  String?
  mood  String?
  photo String?
  tags  String?
  time  String?
}

model ShoppingItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcode       String?
  name          String
  brand         String?
  imageUrl      String?
  verdictStatus String   @default("green")
  checked       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  category  String
  status    String   @default("pending")
  dayIndex  Int?
  createdAt DateTime @default(now())
}

model AnnaChat {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  reply     String?
  screen    String?
  dayIndex  Int?
  createdAt DateTime @default(now())
}

model AnnaOverlayMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  sender    String
  text      String
  time      String?
  dayIndex  Int?
  createdAt DateTime @default(now())
}

model Achievement {
  id                String  @id
  name              String
  category          String
  type              String
  rarity            String
  xp                Int
  descriptionMale   String
  descriptionFemale String
  image             String
  isSecret          Boolean @default(false)
  availableFromDay  Int     @default(1)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlocked      Boolean     @default(false)
  unlockedAt    DateTime?
  xp            Int         @default(0)

  @@unique([userId, achievementId])
  @@index([userId])
}

model FoodItem {
  id                String   @id @default(cuid())
  fdcId             Int?
  nameRu            String   @unique
  nameEn            String
  wfpbStatus        String   @default("green")
  createdAt         DateTime @default(now())

  // Макронутриенты (на 100г)
  calories          Float    @default(0)
  protein           Float    @default(0)
  fat               Float    @default(0)
  carbohydrates     Float    @default(0)
  water             Float    @default(0)

  // Углеводы детализация
  fiber             Float    @default(0)
  sugarTotal        Float    @default(0)
  sucrose           Float    @default(0)
  glucose           Float    @default(0)
  fructose          Float    @default(0)
  lactose           Float    @default(0)
  maltose           Float    @default(0)

  // Жиры детализация
  saturatedFat       Float   @default(0)
  monounsaturatedFat Float   @default(0)
  polyunsaturatedFat Float   @default(0)
  transFat           Float   @default(0)
  cholesterol        Float   @default(0)
  omega3             Float   @default(0)
  omega6             Float   @default(0)
  omega9             Float   @default(0)

  // Минералы
  calcium           Float    @default(0)
  iron              Float    @default(0)
  magnesium         Float    @default(0)
  phosphorus        Float    @default(0)
  potassium         Float    @default(0)
  sodium            Float    @default(0)
  zinc              Float    @default(0)
  copper            Float    @default(0)
  manganese         Float    @default(0)
  iodine            Float    @default(0)
  selenium          Float    @default(0)

  // Витамины
  vitaminC          Float    @default(0)
  thiamin           Float    @default(0)
  riboflavin        Float    @default(0)
  niacin            Float    @default(0)
  pantothenicAcid   Float    @default(0)
  vitaminB6         Float    @default(0)
  biotin            Float    @default(0)
  folate            Float    @default(0)
  vitaminB12        Float    @default(0)
  vitaminA          Float    @default(0)
  retinol           Float    @default(0)
  betaCarotene      Float    @default(0)
  vitaminD          Float    @default(0)
  vitaminD2         Float    @default(0)
  vitaminD3         Float    @default(0)
  vitaminE          Float    @default(0)
  vitaminK          Float    @default(0)

  // Аминокислоты
  lysine            Float    @default(0)
  methionine        Float    @default(0)
  tryptophan        Float    @default(0)
  threonine         Float    @default(0)
  isoleucine        Float    @default(0)
  leucine           Float    @default(0)
  cystine           Float    @default(0)
  phenylalanine     Float    @default(0)
  tyrosine          Float    @default(0)
  valine            Float    @default(0)
  arginine          Float    @default(0)
  histidine         Float    @default(0)
  alanine           Float    @default(0)
  asparticAcid      Float    @default(0)
  glutamicAcid      Float    @default(0)
  glycine           Float    @default(0)
  proline           Float    @default(0)
  serine            Float    @default(0)

  @@index([nameRu])
  @@index([nameEn])
}

model EveningRitual {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  dayIndex         Int
  answerBody       String
  answerPsycho     String
  answerUnexpected String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, dayIndex])
}
