# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Token from @BotFather for the Club bot.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_GROUP_INVITE_LINK: Invite link to the Telegram Club chat (with Admin Approval enabled).
TELEGRAM_GROUP_INVITE_LINK=""

# SERVER_URL: The public production URL (used for Telegram webhook).
SERVER_URL="https://app.vsedelovede.ru"

# USDA_API_KEY: API key for USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup.html)
USDA_API_KEY="DEMO_KEY"

# PURCHASE_API_KEY: ключ для POST /api/purchase/register (лендинг выдаёт инвайты).
# Без него маршрут закрыт (503): при пустом значении старая проверка пропускала любой запрос.
# Значение генерируют отдельно и кладут в секрет контура, в репозиторий оно не попадает.
PURCHASE_API_KEY=""

# TELEGRAM_WEBHOOK_SECRET: значение secret_token для регистрации вебхуза Telegram.
# Маршрут /api/telegram-webhook смонтирован выше auth и доступен извне; без этого значения
# Telegram шлёт запросы с заголовком x-telegram-bot-api-secret-token, а сервер принимает
# любой апдейт, кто бы его ни прислал. В production при пустом значении маршрут вообще
# не монтируется (обновления не принимаются), в дев-режиме проверка выключена.
# Генерируют отдельно и кладут в секрет контура: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
