{
  "name": "bookport",
  "private": true,
  "version": "12.0.0-beta",
  "type": "module",
  "scripts": {
    "clean:port": "kill-port 3000 3001 3002 || true",
    "dev:clean": "npm run clean:port && rm -rf node_modules/.vite",
    "dev": "npm run dev:clean && BOOK_REGISTRY_RUNTIME=1 BOOK_REGISTRY_SHADOW=1 tsx watch --ignore \"src/**/*\" server.ts",
    "dev:server": "BOOK_REGISTRY_RUNTIME=1 BOOK_REGISTRY_SHADOW=1 tsx watch server.ts",
    "dev:client": "vite",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs && mkdir -p dist/src/assets/images/anna && cp -r src/assets/images/anna/* dist/src/assets/images/anna/",
    "start": "NODE_ENV=production BOOK_REGISTRY_RUNTIME=1 BOOK_REGISTRY_SHADOW=1 node dist/server.mjs",
 7123309 (feat(book): compiled registry, F-sync, each-split, technical guard, approved excluded, BUILD-1 partial fix)
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "verify:book": "tsx scripts/verifyBookCatalog.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@prisma/client": "^6.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.45.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "telegraf": "^4.16.3",
    "undici": "^7.0.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vercel": "^57.0.0",
    "vite": "^6.2.3"
  }
}
